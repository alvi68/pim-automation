{
  "name": "pim-automation",
  "version": "1.0.0",
  "description": "UI automation framework for OrangeHRM PIM module using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug=inspector",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e"
  ],
  "author": "Muhammad",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  }
}
